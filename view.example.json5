// wwx.touchbar —— 整个文件就是一棵树（JSON5：注释、尾逗号、裸键都行）
// 顶层对象的 children 就是根层那排键；任何节点都能再有 children：点它进一层，
// 最右侧出现层级键 ‹当前层名，点它回上一级。
//   gap    = 该键左侧的间距（不写就用顶层的 gap）—— 想分组就在新块第一个键上写
//   text        = 该层出现文字区，子层继承（agent 的 status 文字会覆盖它）
//   windowMatch = 聚焦/注入时认哪个窗口（class/title/进程名关键词，子层继承）
// 叶子只有一种行为：action: "cmd: <shell>"。要干什么就写什么命令。
{
  buttonWidth: 85,
  gap: 4,
  levelGap: 44,

  children: [
    { label: "音 +", action: "cmd: t1tb volume up" },
    { label: "音 −", action: "cmd: t1tb volume down" },
    { label: "静", action: "cmd: t1tb volume mute", gap: 22 },
    { label: "亮 +", action: "cmd: t1tb display up", gap: 22 },
    { label: "亮 −", action: "cmd: t1tb display down" },
    {
      label: "键",
      text: "控制键盘背光",
      gap: 22,
      children: [
        { label: "键 +", action: "cmd: t1tb kbd up" },
        { label: "键 −", action: "cmd: t1tb kbd down" },
        { label: "键", action: "cmd: t1tb kbd toggle", gap: 22 },
      ],
    },
    {
      label: "AI",
      gap: 44,
      text: "AI 交互模式 · 右侧 ‹AI 回根层",
      windowMatch: ["omarchy.agent", "hermes"],
      children: [
        { label: "生", action: "cmd: t1tb open omarchy-launch-terminal hermes chat" },
        { label: "死", action: "cmd: t1tb finish" },   // 一次=发收尾提示词，再点一次=关窗
        { label: "善", action: "cmd: t1tb insert 善", gap: 22 },
        { label: "恶", action: "cmd: t1tb insert no" },
        { label: "研", action: "cmd: t1tb insert 先研究清楚再动手", gap: 22 },
        { label: "易", action: "cmd: t1tb insert 换个方向，先别沿这条走" },
        { label: "习", action: "cmd: t1tb insert 把这次会话里可复用的内容整理评估后沉淀成技能" },
        { label: "册", action: "cmd: t1tb insert 把这次工作的经验知识整理到wiki" },
        { label: "声", action: "cmd: t1tb voice toggle", gap: 22 },
      ],
    },
    {
      // 物理 Fn 键：点一下进入这层，再点一下回到进来之前那一层。
      // hidden = 不在根层显示入口按钮，只靠 Fn 键进（也可 t1tb goto Fn）。
      label: "Fn",
      key: "fn",
      hidden: true,
      // F1–F12 是短标签，把这一层的键做宽、间距放宽，好按。
      buttonWidth: 120,
      gap: 16,
      text: "再按 Fn 返回",
      children: [
        { label: "F1", action: "cmd: t1tb key f1" },
        { label: "F2", action: "cmd: t1tb key f2" },
        { label: "F3", action: "cmd: t1tb key f3" },
        { label: "F4", action: "cmd: t1tb key f4" },
        { label: "F5", action: "cmd: t1tb key f5" },
        { label: "F6", action: "cmd: t1tb key f6" },
        { label: "F7", action: "cmd: t1tb key f7" },
        { label: "F8", action: "cmd: t1tb key f8", gap: 22 },
        { label: "F9", action: "cmd: t1tb key f9" },
        { label: "F10", action: "cmd: t1tb key f10" },
        { label: "F11", action: "cmd: t1tb key f11" },
        { label: "F12", action: "cmd: t1tb key f12" },
      ],
    },
  ],
}
